{
  "name": "auto-jobs",
  "version": "0.1.0",
  "private": true,
  "description": "A Playwright V1 runner for Jenkins-rendered SonarQube and Snyk vulnerability reports.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "install": "playwright install chromium",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-report-css.mjs",
    "report": "node scripts/run-report.mjs",
    "inspect:jenkins-login": "node scripts/inspect-jenkins-login.mjs",
    "serve:report": " npm run build &&  node .runner-build/reporting/report-server-cli.js",
    "typecheck": " tsc --noEmit",
    "test:unit": " node scripts/run-playwright.mjs playwright test tests/unit --config=playwright.unit.config.ts --pass-with-no-tests",
    "test:report": "PLAYWRIGHT_REPORT_ONLY=1  node scripts/run-playwright.mjs playwright test tests/e2e/generated-report.spec.ts --pass-with-no-tests",
    "test:release": " npm run typecheck &&  npm run build &&  npm run test:unit &&  npm run test:report",
    "test:release:webkit": "docker compose -f docker-compose.webkit.yml run --rm --no-deps webkit",
    "test:e2e:templates": " node scripts/run-playwright.mjs playwright test tests/e2e/template-navigation.spec.ts --config=playwright.template.config.ts",
    "test:e2e:build-now": "JENKINS_BASE_URL=${JENKINS_BASE_URL:-http://127.0.0.1:${JENKINS_PORT:-8080}} JENKINS_USERNAME=${JENKINS_USERNAME:-local-admin} JENKINS_PASSWORD=${JENKINS_PASSWORD:-local-fixture-password} JENKINS_JOB_PATH=playwright-vulnerability-report-build-now  node scripts/run-playwright.mjs playwright test tests/e2e/build-now-job.spec.ts --pass-with-no-tests",
    "test:e2e": "JENKINS_BASE_URL=${JENKINS_BASE_URL:-http://127.0.0.1:${JENKINS_PORT:-8080}} JENKINS_USERNAME=${JENKINS_USERNAME:-local-admin} JENKINS_PASSWORD=${JENKINS_PASSWORD:-local-fixture-password} JENKINS_JOB_PATH=${JENKINS_JOB_PATH:-playwright-vulnerability-report}  node scripts/run-playwright.mjs playwright test tests/e2e --pass-with-no-tests",
    "test": " npm run typecheck &&  npm run test:unit &&  npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
