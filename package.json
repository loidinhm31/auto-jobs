{
  "name": "jenkins-playwright-vulnerability-reports",
  "version": "0.1.0",
  "private": true,
  "description": "A Playwright V1 runner for Jenkins-rendered SonarQube and Snyk vulnerability reports.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "install": "playwright install chromium",
    "build": "tsc -p tsconfig.build.json",
    "report": "npm run build && node .runner-build/cli.js",
    "typecheck": "tsc --noEmit",
    "test:unit": "playwright test tests/unit --config=playwright.unit.config.ts --pass-with-no-tests",
    "test:e2e": "JENKINS_BASE_URL=${JENKINS_BASE_URL:-http://127.0.0.1:8080} JENKINS_USERNAME=${JENKINS_USERNAME:-local-admin} JENKINS_PASSWORD=${JENKINS_PASSWORD:-local-fixture-password} JENKINS_JOB_PATH=${JENKINS_JOB_PATH:-playwright-vulnerability-report} playwright test tests/e2e --pass-with-no-tests",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
