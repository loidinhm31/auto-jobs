{
  "schemaVersion": 1,
  "defaults": {
    "credentials": {
      "usernameVariable": "JENKINS_USERNAME",
      "passwordVariable": "JENKINS_PASSWORD"
    },
    "timeoutMs": 300000,
    "browser": "chromium",
    "artifactDir": "reports"
  },
  "projects": [
    {
      "id": "service-a",
      "name": "Service A",
      "enabled": true,
      "runType": "report",
      "loginUrl": "https://jenkins.example.invalid/jenkins/login",
      "jobUrl": "https://jenkins.example.invalid/jenkins/job/Container%20Platform/job/service-a/job/release%252Fsit/",
      "sourceOrigins": {
        "jenkins": ["https://jenkins.example.invalid"],
        "snyk": ["https://snyk.example.invalid"],
        "sonarqube": ["https://sonarqube.example.invalid"]
      }
    },
    {
      "id": "service-b",
      "name": "Service B",
      "enabled": false,
      "runType": "auto-build",
      "loginUrl": "https://jenkins.example.invalid/jenkins/login",
      "jobUrl": "https://jenkins.example.invalid/jenkins/job/Container%20Platform/job/service-b/job/main/",
      "credentials": {
        "usernameVariable": "SERVICE_B_JENKINS_USERNAME",
        "passwordVariable": "SERVICE_B_JENKINS_PASSWORD"
      },
      "sourceOrigins": {
        "jenkins": ["https://jenkins.example.invalid"],
        "snyk": ["https://snyk.example.invalid"],
        "sonarqube": ["https://sonarqube.example.invalid"]
      }
    }
  ]
}
