  projects: ProjectConfigInput[];
  defaults?: ProjectConfigDefaults;
}

interface ProjectConfigInput {
  id: string;
  name: string;
  loginUrl: string;
  jobUrl: string;
  runType?: 'report' | 'auto-build';
