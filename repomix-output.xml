    await store.deleteSecret('TEMP_KEY');
    expect(await store.listSecretNames()).toEqual(['API_TOKEN', 'WEBHOOK_KEY']);

    await store.deleteSecrets(['API_TOKEN', 'NON_EXISTENT']);
