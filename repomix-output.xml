  const timestamp = now.toISOString().toLowerCase().replace(/[^0-9a-z]/gu, '');
  const normalizedSuffix = suffix.toLowerCase();
  if (!/^[0-9a-f]{8,64}$/u.test(normalizedSuffix)) {
