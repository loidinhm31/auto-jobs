        ...(title === undefined ? {} : { title }),
        severity,
        ...(module === undefined ? {} : { module }),
        ...(description === undefined ? {} : { description }),
        ...(remediation === undefined ? {} : { remediation }),
        ...(paths.length === 0 ? {} : { paths }),
        ...(references.length === 0 ? {} : { references }),
