  let ignoredIncompatibleCount = 0;
  let incompatibleLimitReached = false;
  const noteIncompatible = (): void => {
    if (ignoredIncompatibleCount < MAX_DIAGNOSTICS) {
      ignoredIncompatibleCount += 1;
    } else {
      incompatibleLimitReached = true;
    }
  };
