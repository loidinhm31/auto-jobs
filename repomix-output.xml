      align-items: center;
      background: var(--background);
      border-radius: 100px;
      box-shadow: 0 0 0 1.5px color-mix(in sRGB, var(--text-color-secondary) 9%, transparent);
      content: "";
      display: flex;
      height: 20px;
      justify-content: center;
      left: 5px;
      mask-position: center center;
      mask-size: 60px 60px;
      position: absolute;
      top: 5px;
      transition: var(--standard-transition);
      width: 20px
