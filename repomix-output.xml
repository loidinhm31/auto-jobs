export async function captureSonarqubeEvidence(input: SonarCaptureInput): Promise<SonarCaptureResult> {
  const warnings: string[] = [...(input.discoveryWarnings ?? [])];
  const captures: CaptureMetadata[] = [];
  const screenshots: string[] = [];
