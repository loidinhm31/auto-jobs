      ...(scannedPath === undefined ? {} : { scannedPath }),
      ...(packageManager === undefined ? {} : { packageManager }),
      ...(project === undefined ? {} : { project }),
      ...(dependencyCount === undefined ? {} : { dependencyCount }),
      ...(dependencyPathCount === undefined ? {} : { dependencyPathCount }),
      ...semanticMetadata,
