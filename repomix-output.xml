): SnykSourceEvidence {
  return {
    ...safeSource(value),
    ...(value.summary === undefined ? {} : { summary: safeSummary(value.summary, sanitize) }),
    ...(value.findings === undefined ? {} : { findings: value.findings.slice(0, MAX_SNYK_FINDINGS).map((finding) => safeFinding(finding, sanitize)) }),
