  if (expanded !== null && expanded !== 'true') {
    await facet.header.click({ timeout: input.deadline.requireRemaining() });
    await expect(facet.header).toHaveAttribute('aria-expanded', 'true', {
      timeout: input.deadline.requireRemaining(),
    });
