export const REQUIRED_NAVIGATION_TARGET_KEYS: readonly NavigationTargetKey[] = [
  'jenkins-job',
  'snyk-report',
  'sonarqube-home',
  'sonarqube-overall',
  'sonarqube-issues',
];

