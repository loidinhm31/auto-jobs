      animation: rdp-slide_out_right var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    .rdp-root[dir="rtl"] .rdp-weeks_after_enter {
      animation: rdp-slide_in_left var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    .rdp-root[dir="rtl"] .rdp-weeks_before_exit {
      animation: rdp-slide_out_right var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    .rdp-root[dir="rtl"] .rdp-weeks_before_enter {
      animation: rdp-slide_in_right var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    .rdp-root[dir="rtl"] .rdp-weeks_after_exit {
      animation: rdp-slide_out_left var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    @keyframes rdp-fade_in {
      0% {
        opacity: 0
      }

      100% {
        opacity: 1
      }
    }

    @keyframes rdp-fade_out {
      0% {
        opacity: 1
      }

      100% {
        opacity: 0
      }
    }

    .rdp-caption_after_enter {
      animation: rdp-fade_in var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    .rdp-caption_after_exit {
      animation: rdp-fade_out var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    .rdp-caption_before_enter {
      animation: rdp-fade_in var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    .rdp-caption_before_exit {
      animation: rdp-fade_out var(--rdp-animation_duration) var(--rdp-animation_timing) forwards
    }

    .tooltip {
      position: absolute;
      z-index: 9001;
      display: block;
      height: auto;
      box-sizing: border-box;
      font-weight: 400;
      font-size: 14px;
      line-height: 20px;
      animation: 0.3s ease 0s 1 normal forwards running fadeIn
    }

    .tooltip.top {
      padding: 5px 0px;
      margin-top: -3px
    }

    .tooltip.right {
      padding: 0px 5px;
      margin-left: 3px
    }

    .tooltip.bottom {
      padding: 5px 0px;
      margin-top: 3px
    }

    .tooltip.left {
      padding: 0px 5px;
      margin-left: -3px
    }

    .tooltip-inner {
      font: var(--echoes-typography-paragraph-small-regular);
      max-width: 22rem;
      text-align: left;
      text-decoration: none;
      border-radius: var(--echoes-border-radius-200);
      overflow: hidden;
      word-break: break-word;
      padding: var(--echoes-dimension-space-50) var(--echoes-dimension-space-150);
      color: var(--echoes-color-text-on-color);
      background-color: var(--echoes-color-surface-inverse-default)
    }

    .tooltip-inner .alert {
      margin-bottom: 5px;
      border-radius: 4px
    }

    .tooltip-inner a {
      border-bottom-color: rgb(189, 198, 255);
      color: rgb(189, 198, 255)
    }

    .tooltip-inner hr {
      background-color: rgb(93, 109, 117)
    }

    .tooltip-arrow {
      position: absolute;
      width: 0px;
      height: 0px;
      border: solid transparent
    }

    .tooltip.top .tooltip-arrow {
      bottom: 0px;
      left: 50%;
      border-width: 5px 5px 0px;
      transform: translate(-5px);
      border-top-color: rgb(42, 47, 64)
    }

    .tooltip.right .tooltip-arrow {
      top: 50%;
      left: 0px;
      transform: translateY(-5px);
      border-width: 5px 5px 5px 0px;
      border-right-color: rgb(42, 47, 64)
    }

    .tooltip.left .tooltip-arrow {
      top: 50%;
      right: 0px;
      transform: translateY(-5px);
      border-width: 5px 0px 5px 5px;
      border-left-color: rgb(42, 47, 64)
    }

    .tooltip.bottom .tooltip-arrow {
      top: 0px;
      left: 50%;
      transform: translate(-5px);
      border-width: 0px 5px 5px;
      border-bottom-color: rgb(42, 47, 64)
    }

    .tooltip button[disabled] {
      pointer-events: none
    }

    .tooltip .issue-message-highlight-CODE {
      background-color: rgba(255, 255, 255, 0.18)
    }

