    expect(current.state).toBe('live');
    if (current.state === 'live') expect(current.startedAt).toMatch(/^\d{4}-\d{2}-\d{2}T/u);
    expect(await inspectProcessInstance(99_999_999)).toEqual({ state: 'dead' });
  } else {
    expect(current).toEqual({ state: 'live' });
  }
});

