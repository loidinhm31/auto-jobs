  const sonarHomeCandidates = jobLinks.filter((url) =>
    url.origin === SAVED_SONAR_ORIGIN && isDashboardPath(url) &&
    exactlyOneQueryValue(url, 'id') !== undefined && url.searchParams.getAll('codeScope').length === 0);
