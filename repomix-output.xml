      min-width: 256px;
      display: block
    }

    .range-slider {
      width: 100%
    }

    .range-slider-range {
      appearance: none;
      width: calc(100% - 73px);
      height: 8px;
      border-radius: 5px;
      background: rgb(215, 220, 223);
      outline: none;
      padding: 0px;
      margin: 0px
    }

    .range-slider-range::-webkit-slider-thumb {
      appearance: none;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: rgb(44, 62, 80);
      cursor: pointer;
      transition: background 0.15s ease-in-out
    }

    .range-slider-range::-webkit-slider-thumb:hover {
