    await bounded(() => handle.writeFile(contents, 'utf8'), deadline);
    requireDeadline(deadline);
    await bounded(() => handle.sync(), deadline);
    requireDeadline(deadline);
  } finally {
    await cleanupWithinRemaining(() => handle.close(), deadline).catch(() => undefined);
  }
  return temporary;
}

