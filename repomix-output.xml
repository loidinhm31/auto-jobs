  <style type="text/css"
    data-original-href="https://jenkins-example.example-domain.com/static/00f0c7c9/plugin/echarts-api/css/jenkins-style.css">
    .card-chart {
      width: 100%;
      min-height: 256px;
      min-width: 256px;
      display: block
    }

    .range-slider {
      width: 100%
    }

    .range-slider-range {
      appearance: none;
      width: calc(100% - 73px);
      height: 8px;
      border-radius: 5px;
      background: rgb(215, 220, 223);
      outline: none;
      padding: 0px;
      margin: 0px
    }

    .range-slider-range::-webkit-slider-thumb {
      appearance: none;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: rgb(44, 62, 80);
      cursor: pointer;
      transition: background 0.15s ease-in-out
    }

    .range-slider-range::-webkit-slider-thumb:hover {
      background: rgb(13, 110, 253)
    }

    .range-slider-range:active::-webkit-slider-thumb {
      background: rgb(13, 110, 253)
    }

    .range-slider-range:focus::-webkit-slider-thumb {
      box-shadow: rgb(255, 255, 255) 0px 0px 0px 3px, rgb(13, 110, 253) 0px 0px 0px 6px
    }

    .range-slider-value {
      display: inline-block;
      position: relative;
      width: 60px;
      color: rgb(255, 255, 255);
      line-height: 18px;
      text-align: center;
      border-radius: 3px;
      background: rgb(44, 62, 80);
      padding: 5px 10px;
      margin-left: 8px
    }

    .range-slider-value::after {
      position: absolute;
      top: 8px;
      left: -7px;
      width: 0px;
      height: 0px;
      border-top: 7px solid transparent;
      border-right: 7px solid rgb(44, 62, 80);
      border-bottom: 7px solid transparent;
      content: ""
    }
  </style>
