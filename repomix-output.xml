      BETA_KEY: 'beta-val',
      ZEBRA_KEY: 'zebra-val',
    });
    expect(Object.isFrozen(secrets)).toBe(true);

    const fileContent = fs.readFileSync(path.join(configRoot, SECRETS_FILE_NAME), 'utf8');
