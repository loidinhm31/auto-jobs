    `$items = @(Get-CimInstance -ClassName Win32_Process -Filter 'ProcessId = ${pid}')`,
    "if ($items.Count -eq 0) { 'DEAD'; exit 0 }",
    "if ($items.Count -ne 1 -or $null -eq $items[0].CreationDate) { exit 1 }",
