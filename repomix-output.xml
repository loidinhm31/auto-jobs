    .global-loading {
      width: 300px;
      margin: 200px auto 0px;
      white-space: nowrap;
      font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
      color: rgb(62, 67, 87)
    }

    .global-loading-spinner {
      display: inline-block;
      box-sizing: border-box;
      vertical-align: middle;
      width: 80px;
      height: 80px;
      border: 2px solid transparent;
      border-radius: 625rem;
      background: linear-gradient(0deg, rgb(93, 108, 208) 50%, transparent 50%, transparent 100%) border-box border-box, linear-gradient(90deg, rgb(93, 108, 208) 25%, transparent 75%, transparent 100%) border-box border-box;
      mask: linear-gradient(white 0px, white 0px) padding-box exclude, linear-gradient(white 0px, white 0px);
      animation: 1s linear 0s infinite normal none running global-loading-spin
    }

    .global-loading-text {
      display: inline-block;
      vertical-align: middle;
      margin-left: 30px;
      font-size: 36px;
      font-weight: 300
    }

    @keyframes global-loading-spin {
      0% {
        transform: rotate(0deg)
      }

      100% {
        transform: rotate(-360deg)
      }
    }

