    markOld(directory);
    markOld(claimPath);
    expect(await reclaimIncompleteLock(reportRoot, NOW.getTime(), 1_000, os.hostname(), async () => ({ state: 'live', startedAt: REUSED_AT }))).toBe(true);
    expect(fs.existsSync(directory)).toBe(false);
  } finally {
